# URL do backend usada pelo app (frontend).
# Em desenvolvimento local, use o IP da sua máquina na rede Wi-Fi, ex:
# EXPO_PUBLIC_API_URL=http://192.168.15.64:3000
#
# Em produção/preview (EAS Build), use a URL pública do backend no Render:
# EXPO_PUBLIC_API_URL=https://dojo-backend-ofn6.onrender.com
EXPO_PUBLIC_API_URL=https://dojo-backend-ofn6.onrender.com
